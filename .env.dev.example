APP_ENV=dev
NODE_ENV=development
PORT=3333

POSTGRES_USER=replace_dev_user
POSTGRES_PASSWORD=replace_dev_password
POSTGRES_DB=mindway_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://replace_dev_user:replace_dev_password@localhost:5432/mindway_dev?schema=public
DIRECT_URL=postgresql://replace_dev_user:replace_dev_password@localhost:5432/mindway_dev?schema=public

REDIS_PASSWORD=replace_dev_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:replace_dev_redis_password@localhost:6379

CORS_ORIGIN=http://localhost:3000,http://localhost:4200
JWT_ACCESS_SECRET=replace_with_long_local_access_secret
JWT_REFRESH_SECRET=replace_with_long_local_refresh_secret
JWT_ACCESS_EXPIRES_IN=45m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_PATH=/
COOKIE_MAX_AGE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=200
LOG_LEVEL=debug

EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
