APP_ENV=prod
NODE_ENV=production
PORT=3333
API_IMAGE=mindway-api:prod

# Supabase pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
REDIS_URL=rediss://default:password@your-production-redis.example.com:6379

CORS_ORIGIN=https://your-production-frontend.example.com
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=45m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_NAME=refresh_token
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SAMESITE=none
COOKIE_PATH=/
COOKIE_MAX_AGE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=200
LOG_LEVEL=info

EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
