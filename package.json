{
  "name": "mindway-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "prisma": {
    "schema": "src/infra/database/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "node --env-file=.env.dev --import tsx --watch src/index.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:prod": "node --env-file=.env.prod dist/src/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "cross-env APP_ENV=dev NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env APP_ENV=dev NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
    "test:coverage": "cross-env APP_ENV=dev NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "test:unit": "cross-env APP_ENV=dev NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --runInBand",
    "test:integration": "cross-env APP_ENV=dev NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --runInBand",
    "test:controllers": "cross-env APP_ENV=dev NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --selectProjects controllers --runInBand",
    "test:middlewares": "cross-env APP_ENV=dev NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --selectProjects middlewares --runInBand",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev && prisma generate",
    "db:migrate:prod": "prisma migrate deploy && prisma generate",
    "db:reset:dev": "prisma migrate reset && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.14.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "prisma": "^6.0.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.11",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.12.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
